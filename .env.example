# =============================================================
# Konfigurasi Pipeline (salin file ini menjadi .env lalu isi)
# =============================================================

# --- Pilih provider LLM cloud: openai | gemini | azure ---
LLM_PROVIDER=openai

# --- OpenAI (dipakai bila LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Opsional: endpoint OpenAI-compatible (proxy)
# OPENAI_BASE_URL=https://your-endpoint/v1

# --- Google Gemini (dipakai bila LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# --- Microsoft Azure OpenAI (dipakai bila LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-06-01
# 'DEPLOYMENT' = nama deployment di Azure (bukan nama model mentah)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Retry saat panggilan LLM gagal ---
LLM_MAX_RETRIES=4

# =============================================================
#  BACKEND FastAPI (analisis berat: SBERT/reranker/NLI/QA/LLM)
# =============================================================
# Kunci API internal. Harus SAMA antara backend & frontend (header X-API-Key).
PIPELINE_API_KEY=sam-n8n-secret
PIPELINE_PORT=8000
# Host bind backend. Default 127.0.0.1 (aman, dipanggil frontend di mesin sama).
PIPELINE_API_HOST=127.0.0.1

# =============================================================
#  FRONTEND FastAPI (web_app.py — pengganti index.php)
# =============================================================
# Port web UI yang dibuka dari browser / PC lain di LAN.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Alamat backend yang dipanggil frontend. Default 127.0.0.1:8000.
PIPELINE_API_BASE=http://127.0.0.1:8000
# 1 = SELALU pakai backend lokal (abaikan field 'ngrok url' di form). Disarankan 1.
PIPELINE_FORCE_LOCAL=1

# --- Google service account (Step 1 tarik log & Step 3/13 tarik intent) ---
# Letakkan file service-account.json di folder yang sama, ATAU set path ini.
# PIPELINE_SA_FILE=./service-account.json
# Project Dialogflow (default sudah diisi sesuai index.php).
# PIPELINE_PROJECT_ID=avaya-djp-klipbot-prod

# --- Folder hasil/kerja. Dipakai checkpoint speedpatch DAN slot katalog Audit. ---
# PENTING: agar menu "Audit Training Phrase" (Gunakan Data Terakhir) tetap
# menemukan katalog setelah aplikasi di-restart, arahkan ke folder TETAP
# (absolute path), JANGAN folder sementara. Katalog harian disimpan di
# <PIPELINE_RUNS_DIR>/auto-daily dan ditimpa tiap penarikan.
# PIPELINE_RUNS_DIR=./_runs
# PIPELINE_WORKDIR=./_tmp

# --- Opsional: matikan auto-install pip (1 = jangan install otomatis) ---
# PIPELINE_NO_INSTALL=1

# =============================================================
# SISTEM ANALITIK (dashboard + AI tanya-jawab data)
# =============================================================
# Lokasi file database SQLite (default: analytics.db di folder web_app.py)
# PIPELINE_DB_FILE=./analytics.db

# Penjadwal ingest harian otomatis. 1=aktif (default), 0=matikan.
PIPELINE_SCHEDULER=1
# Jam & menit ingest harian (zona Asia/Jakarta). Default 08:00 -> tarik data H-1.
PIPELINE_INGEST_HOUR=8
PIPELINE_INGEST_MINUTE=0
# Bahasa log yang ditarik otomatis (id / en).
PIPELINE_INGEST_LANG=id

# --- Refresh katalog intent + training phrase (Step 3) untuk menu Audit ---
# CATATAN: ingest harian di atas HANYA menarik LOG percakapan (analytics.db),
# BUKAN training phrase. Katalog untuk "Audit Training Phrase" ditarik terpisah
# langsung dari Dialogflow Agent API oleh penjadwal ini.
# Otomatis tiap hari agar "Gunakan Data Terakhir" selalu segar. 1=aktif (default), 0=matikan.
PIPELINE_CATALOG_REFRESH=1
# Nama slot run tetap tempat katalog harian disimpan (ditimpa tiap penarikan).
PIPELINE_CATALOG_RUN=auto-daily
# Jam & menit refresh katalog (Asia/Jakarta). Kosongkan untuk ikut jam ingest di atas.
# PIPELINE_CATALOG_HOUR=8
# PIPELINE_CATALOG_MINUTE=0

# =============================================================
# RAG FASE 0 (v14) — Model embedding & reranker
# =============================================================
# PENTING: mengganti model embedding WAJIB reindex vektor lama — vektor model
# lama TIDAK kompatibel dengan model baru. Jalankan:
#   python phase0_upgrade.py --reindex-all
#
# Unduhan model pertama kali (sekali saja, butuh internet):
#   bge-m3 ~2,2 GB ; bge-reranker-v2-m3 ~1,1 GB.

# Model embedding korpus Peraturan & SOP. Default v14: BAAI/bge-m3 (1024-d,
# multilingual, kuat untuk B. Indonesia). Fallback ringan: intfloat/multilingual-e5-base (768-d).
# PERATURAN_EMBED_MODEL=BAAI/bge-m3
# Prefix otomatis per-model (e5 -> 'query: '/'passage: ', bge-m3 -> tanpa prefix).
# Override manual bila perlu ('' = tanpa prefix):
# PERATURAN_EMBED_QUERY_PREFIX=
# PERATURAN_EMBED_PASSAGE_PREFIX=
# '' auto (cuda bila ada) | cuda | cpu
# PERATURAN_EMBED_DEVICE=
# Batch size encode saat reindex (default 32). Naikkan ke 64-128 di GPU untuk
# reindex lebih cepat. PowerShell: $env:PERATURAN_EMBED_BATCH=96
# PERATURAN_EMBED_BATCH=32

# Model reranker cross-encoder. Default v14: BAAI/bge-reranker-v2-m3 (multilingual).
# Fallback ringan: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 0 = matikan reranker.
# RAG_RERANK=1
# Jumlah kandidat maksimum yang dinilai ulang reranker.
# RAG_RERANK_POOL=30
# RAG_RERANK_DEVICE=

# Gerbang abstain cosine (0 = mati). Kalibrasi nilainya lewat menu /rag-eval
# (sweep), lalu set nilai terpilih di sini dan restart aplikasi.
# RAG_MIN_COS=0
